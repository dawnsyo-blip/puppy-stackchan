# Copy this file to .env and fill in your own keys.
# All three are optional enhancements — puppy_engine_v4.py degrades
# gracefully (falls back to fixed text / skips the feature) when a key is
# missing or invalid. See CLAUDE.md for exactly which features use each.

# DeepSeek LLM (intent classification + conversational replies)
DEEPSEEK_API_KEY=

# Alibaba Cloud DashScope / Qwen-VL (hide-and-seek game: object recognition)
DASHSCOPE_API_KEY=

# QWeather (和风天气) — used to pick weather-flavored keywords for the
# "want to go outside" reminder. QWEATHER_API_HOST is the per-account
# "API Host" subdomain from the QWeather console, not a shared domain.
QWEATHER_API_KEY=
QWEATHER_API_HOST=
